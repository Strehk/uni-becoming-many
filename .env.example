# Copy to `.env` (git-ignored). These configure the M5 bridge — the small server half of this
# repo that talks to the controller (see docs/m5-bridge.md). They are read at *runtime* by
# `bridge/`, not inlined into the client bundle, so changing one means restarting, not rebuilding.
#
# All of them have working defaults; an empty .env is a perfectly normal setup.

# Plain-HTTP port the M5 connects to (`ws://<this-machine>:5184/ws/device`). It cannot be HTTPS:
# the controller firmware rejects wss:// outright. Must be reachable from the controller's LAN.
# Unset -> 5184
M5_DEVICE_PORT=5184

# Where calibration, axis map and the pairing token are stored.
# Unset -> ./.m5 (git-ignored). The container defaults this to /data, mounted as a volume.
# M5_STATE_DIR=/data

# Shared secret the controller must present on /ws/device. Leave it unset and the bridge
# generates one on first start and persists it in M5_STATE_DIR — pin it here only if a
# deployment needs the token to survive a wiped volume without re-pairing the controller.
# M5_PAIRING_TOKEN=

# Production only (bridge/serve.ts): HTTP port for the experience and the browser control
# stream. TLS is terminated by the reverse proxy in front.
# Unset -> 8080
# PORT=8080
